# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:admin@127.0.0.1:5432/RootIQ

# ── Ollama / LLM ────────────────────────────────────────────
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=8bde916c789b45558bdfd3ade9705d62.4QX4Up6r-yTDACUaqtBBTEww

# ── Concurrency (keep Ollama stable) ───────────────────────
# Max number of exceptions processed concurrently during CSV upload.
UPLOAD_CONCURRENCY=100
# Max number of concurrent LLM requests across the app.
LLM_CONCURRENCY=10

# ── Scoring Limits ───────────────────────────────────────────
MIN_WEIGHT=0.5
MAX_WEIGHT=5.0
LEARNING_RATE=0.1

# ── Congested Regions (comma-separated terminal codes) ──────
CONGESTED_REGIONS=

# ── CORS (dev front-end integration) ───────────────────────
# Allow React/Vite dev server origins. Browsers send Origin=http://localhost:5173
# even when calling a remote (tunneled) API URL.
CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
CORS_ALLOW_CREDENTIALS=false

# ── Dev-only: wipe DB on startup ───────────────────────────
# DANGER: Deletes all rows from exception tables and resets model weights.
RESET_DB_ON_STARTUP=false
# uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 3000